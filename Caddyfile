# =============================================================================
# Caddyfile — Automatic HTTPS reverse proxy for MedScholar
# =============================================================================
# Replace "medscholar.yourdomain.com" with your actual domain.
# Caddy automatically obtains & renews Let's Encrypt SSL certificates.
#
# Install on EC2:  sudo apt install -y caddy
# Start:           sudo systemctl enable --now caddy
# =============================================================================

medscholar.yourdomain.com {
    reverse_proxy localhost:4000

    # Gzip/Brotli compression for static assets
    encode gzip zstd

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
