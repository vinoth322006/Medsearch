NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://medisearch:medisearch_dev@localhost:5432/medisearch?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth secrets — GENERATE STRONG RANDOM VALUES IN PRODUCTION (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-use-32-bytes-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-use-32-bytes-min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# External APIs (LitSense + E-utilities)
LITSENSE_BASE_URL=https://www.ncbi.nlm.nih.gov/research/litsense-api/api/
LITSENSE_TIMEOUT_MS=8000
LITSENSE_MIN_INTERVAL_MS=1000
EUTILS_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/
EUTILS_API_KEY=
EUTILS_TIMEOUT_MS=8000
EUTILS_MIN_INTERVAL_MS=334

# Cache TTLs (seconds)
SEARCH_CACHE_TTL_SEC=1200
META_CACHE_TTL_SEC=2592000

# Rate limits
ANON_IP_RATE_LIMIT_PER_MIN=12
AUTH_RATE_LIMIT_PER_MIN=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MIN=15

# CORS
CORS_ORIGIN=http://localhost:5173

# Seed admin
SEED_ADMIN_EMAIL=admin@medsearch.local
SEED_ADMIN_PASSWORD=AdminPass!2024

# Privacy: admin visibility of raw user queries (default OFF). Set true ONLY if client confirms.
ADMIN_CAN_VIEW_USER_QUERIES=false

# Logging
LOG_LEVEL=info
